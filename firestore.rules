rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // One document access. Existence is the proof, because a follow document
    // only ever exists once the request behind it has been accepted.
    function followsAuthor(readerId, authorId) {
      return exists(/databases/$(database)/documents/follows/$(readerId + "__" + authorId));
    }

    /**
     * Whether a post can be read by the signed-in account. Shared by the
     * comment and notification rules so "can see this post" is one question
     * with one answer, rather than three copies that can drift apart.
     */
    function canSeePost(post) {
      return signedIn()
        && (post.authorUid == request.auth.uid
          || followsAuthor(request.auth.uid, post.authorUid));
    }

    /** The same question for a notification, asked about its post id. */
    function canSeeSourcePost() {
      let p = get(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      return p.exists() && canSeePost(p.data);
    }

    // Exercise catalog: readable by any signed-in user; seeded once client-side
    // (re-seeds may update existing docs when the catalog version bumps)
    match /exercises/{exerciseId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Seed marker
    match /meta/{docId} {
      allow read, write: if signedIn();
    }

    // User profile / onboarding preferences: each user reads and writes only
    // their own. Delete is allowed so account deletion can clean up after
    // itself rather than leaving an orphaned preferences document behind.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Profile photo, kept out of the profile document so the one the route
    // guard reads on every navigation stays small. Cloud Storage would need a
    // billing-enabled project, so the resized image lives here as bytes.
    match /users/{uid}/{docId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Training splits the athlete defined themselves: a routine is a named
    // session on chosen weekdays with an ordered exercise list. There is no
    // house split, so this is the only place one lives.
    match /users/{uid}/routines/{routineId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Nutrition: meals logged, repeatable meals saved from them, and the
    // athlete's own cache of foods they have looked up. All private. There is
    // no sharing path for a meal, so no rule below reads anything but the
    // owner.
    //
    // The food cache is deliberately per-athlete rather than one shared
    // collection like `exercises`. That catalog is data this app ships, so any
    // client may write it. Food data comes from a third-party API and is cached
    // per athlete, so a shared collection would let one client write wrong
    // macros into everybody's search results.
    match /users/{uid}/meals/{mealId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/templates/{templateId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/foods/{foodId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Social ----------
    //
    // Following is one-directional and revocable, and a shared summary only
    // ever reaches the people this account follows. Firestore rules are the
    // only thing standing between a summary and a stranger, because any client
    // can be modified, so every read below is written to be safe on its own
    // rather than relying on the query that happens to be running.

    // Read code: a signed-in user can see which name a code belongs to, and
    // only ever the uid and the display name. There is nothing else on it.
    match /handles/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // Renaming keeps the code pointed at the same person.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A follow that exists is a follow that was accepted. Nothing needs reading
    // out of it to prove that, which matters: a rules check may make at most 10
    // document access calls per request, and a feed query arrives with dozens of
    // rows to check. A separate collection per state is what keeps that at one
    // call per row instead of two.
    match /follows/{edgeId} {
      // The path variable is the document id, which is `follower__followee`,
      // so it never equals a bare uid. Ownership has to be read off the
      // document's own fields, or every read below is denied forever.
      allow read: if signedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.followeeUid == request.auth.uid);

      // Only the person being followed can create a follow, and only in answer
      // to a request they were actually sent. Nobody follows themselves, and
      // nobody grants a follow on somebody else's behalf.
      allow create: if signedIn()
        && request.resource.data.followeeUid == request.auth.uid
        && request.resource.data.followerUid != request.auth.uid
        && exists(/databases/$(database)/documents/requests/$(request.resource.data.followerUid + "__" + request.auth.uid));

      // Nothing about an established follow is editable. Unfollowing is a delete.
      allow update: if false;

      // Leaving is the follower's own call. The followee may also drop the
      // edge, which is what lets an account leave the platform without leaving
      // itself in somebody else's following list.
      allow delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.followeeUid == request.auth.uid);
    }

    // A request is an ask, not a follow. It carries no access of its own.
    match /requests/{edgeId} {
      // Same id shape as `follows`, so the same trap: the path variable is the
      // document id and is never equal to a uid.
      allow read: if signedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.followeeUid == request.auth.uid);

      // Anyone may ask to follow, but only as themselves, and never themselves.
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followeeUid != request.auth.uid
        && request.resource.data.keys().hasOnly([
             "followerUid", "followeeUid", "followerName", "followeeName", "createdAt"
           ]);

      allow update: if false;

      // Withdrawing is the follower's own call. Declining is the followee's.
      allow delete: if signedIn()
        && (resource.data.followerUid == request.auth.uid
          || resource.data.followeeUid == request.auth.uid);
    }

    // Feed posts. A post is a summary and nothing else: the session name, the
    // set count, the volume and the date. No exercise, no weight, no rep count
    // is ever written here, and the create rule will not accept a document
    // carrying one. That is the guarantee the privacy choice rests on.
    //
    // On top of that, a summary is readable only by its author and by accounts
    // that follow the author and were accepted. A query that asks for a post
    // the reader may not see gets that one document dropped rather than an
    // error, so the check costs one exists() per row and cannot be sidestepped
    // by editing the client.
    match /posts/{postId} {
      allow read: if signedIn()
        && (resource.data.authorUid == request.auth.uid
          || followsAuthor(request.auth.uid, resource.data.authorUid));

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             "authorUid", "authorName", "workoutName",
             "sets", "volumeKg", "date", "createdAt", "reactions",
             "kind", "commentCount", "notes", "detail"
           ])
        && request.resource.data.reactions.size() == 0
        && request.resource.data.notes.size() == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.sets is int
        && request.resource.data.sets >= 0
        && request.resource.data.volumeKg is number
        && request.resource.data.volumeKg >= 0
        // How much detail a post may carry is the athlete's own setting, and
        // it lives on their profile, so the post cannot claim more than they
        // opted into. A profile written before the setting existed has no
        // `postDetail`, and absence reads as summary rather than as full.
        && (!("detail" in request.resource.data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.postDetail == "full");

      // Reactions, the word that came with one, and the comment count are the only
      // fields anyone may change, and only on a post they can already read:
      // their own, or one from an account they follow. commentCount is here
      // because the count belongs to the thread rather than to whoever is
      // commenting. Nobody can rewrite another athlete's numbers, their name,
      // or the date.
      allow update: if signedIn()
        && (resource.data.authorUid == request.auth.uid
          || followsAuthor(request.auth.uid, resource.data.authorUid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             "reactions", "notes", "commentCount"
           ]);

      // Taking a summary back down is the author's own call.
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      // Comments live here rather than on the post because a post is read by
      // up to 25 people at once and a thread is read by one person at a time.
      // Each allow here spends at most two get() calls on the parent plus one
      // exists() for the follow, which is inside the 10 document access calls a
      // rules evaluation is allowed. `parent()` is called twice in the worst
      // case because rules do not memoise a get(), and short circuits keep the
      // common cases down at one or none.
      match /comments/{commentId} {
        function parent() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }

        // Readable exactly when the post above it is, which is the same test
        // the post's own read rule applies.
        function parentVisible() {
          return signedIn()
            && (parent().authorUid == request.auth.uid
              || followsAuthor(request.auth.uid, parent().authorUid));
        }

        allow read: if parentVisible();

        allow create: if signedIn()
          && parentVisible()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
               "authorUid", "authorName", "body", "mentions", "createdAt"
             ])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 280;

        // A written word is not editable once it is said. Say it again instead.
        allow update: if false;

        // Your own word, or moderation on a post of your own. The first branch
        // short circuits, so deleting your own comment never spends a get().
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
            || parent().authorUid == request.auth.uid);
      }
    }

    // ---------- Notifications ----------
    //
    // No Cloud Functions run on the free plan, so there is nothing to notice a
    // mention and forward it. The person who wrote the comment drops the
    // notification in from their own device instead, which is sound rather than
    // a shortcut: they are already allowed to write the comment, and the rule
    // below proves they could read the post the comment sits under. Without
    // that proof any account could post a bell into anybody else's.

    match /notifications/{uid}/items/{itemId} {
      // The path segment here is a bare uid, so unlike an edge id it can be
      // compared to request.auth.uid directly.
      allow read: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && uid == request.auth.uid;
      allow delete: if signedIn() && uid == request.auth.uid;

      allow create: if signedIn()
        && uid != request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             "fromUid", "fromName", "postId", "body", "createdAt", "read"
           ])
        && request.resource.data.read == false
        && request.resource.data.postId is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 280
        && canSeeSourcePost();
    }

    // Workouts: owner-scoped
    match /workouts/{workoutId} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;

      // Sets subcollection: any signed-in user who can see the parent workout
      match /sets/{setId} {
        function parentWorkout() {
          return get(/databases/$(database)/documents/workouts/$(workoutId)).data;
        }
        allow read, create, update, delete: if signedIn() && parentWorkout().userId == request.auth.uid;
      }
    }
  }
}
